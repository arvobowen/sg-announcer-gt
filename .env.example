# You can find your Teams webhook URL in the Microsoft Teams Workflows tab (sometime you need
# to click the ... button to find it).  Click three dots "..." next to the channel name, select "Edit"
# then expand the "When a Teams webhook request is received" section to find the URL.
# Replace the URLs above with your actual webhook URLs.
#
# --- TEAMS WEBHOOK CONFIGURATION FOR RELEASE CHANNEL ---
# Webhook URL for the main releases channel
TEAMS_RELEASE_WEBHOOK_URL=https://your-release-webhook-url-goes-here.com
#
# --- TEAMS WEBHOOK CONFIGURATION FOR PRERELEASE CHANNEL ---
# Webhook URL for the pre-releases channel
TEAMS_PRERELEASE_WEBHOOK_URL=https://your-prerelease-webhook-url-goes-here.com
#
# --- GITHUB WEBHOOK SECRET ---
# A strong, random string for verifying GitHub webhook payloads
WEBHOOK_SECRET=your-strong-random-secret-here
#
# --- TRACKING STATS PATH CONFIGURATION ---
# The path where tracking stats are stored
TRACKING_STATS_PATH="C:\ProgramData\SpiderGate\sg-docketsafe-updates\TrackingStats"